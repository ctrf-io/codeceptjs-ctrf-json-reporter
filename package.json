{
	"name": "codeceptjs-ctrf-json-reporter",
	"version": "0.1.0",
	"description": "Generate CTRF JSON reports for CodeceptJS tests",
	"main": "./dist/index.cjs",
	"scripts": {
		"build": "tsup && node scripts/write-cjs-shims.mjs",
		"build:check": "tsc -p . --noEmit",
		"test": "npm run build && vitest run",
		"test:coverage": "npm run build && vitest run --coverage",
		"test:integration": "npm run build && node tests/integration/run.mjs",
		"test:package": "npm run build && node scripts/check-package.mjs",
		"lint:check": "biome lint .",
		"format:check": "biome format .",
		"format": "biome format --write .",
		"all": "npm run build:check && npm run lint:check && npm run format:check && npm run test:coverage && npm run test:integration && npm run test:package",
		"test:standard:checker": "node tests/standard/checker/run.mjs",
		"test:standard:conformance:unit": "npm run build && node tests/standard/conformance/run.mjs unit",
		"test:standard:conformance:integration": "npm run build && node tests/standard/conformance/run.mjs integration",
		"test:standard:conformance": "node tests/standard/conformance/run-all.mjs",
		"test:standard": "node tests/standard/run-all.mjs"
	},
	"files": [
		"dist/",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ctrf-io/codeceptjs-ctrf-json-reporter.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"homepage": "https://ctrf.io",
	"author": "Matthew Poulton-White",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@d2t/vitest-ctrf-json-reporter": "1.3.0",
		"@types/node": "26.6.5",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vitest/coverage-v8": "5.0.3",
		"codeceptjs": "4.2.0",
		"tsup": "8.5.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "5.0.3",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1"
	},
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js",
			"require": "./dist/runtime.cjs"
		}
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"ctrf": "0.5.0"
	},
	"peerDependencies": {
		"codeceptjs": "4.2.0"
	},
	"overrides": {
		"codeceptjs": {
			"@xmldom/xmldom": "0.9.12",
			"axios": "1.20.0",
			"uuid": "11.1.1",
			"mocha": {
				"diff": "8.0.3",
				"serialize-javascript": "7.1.2"
			}
		},
		"esbuild": "0.28.2"
	},
	"security": {
		"email": "security@ctrf.io",
		"url": "https://github.com/ctrf-io/.github/blob/main/SECURITY.md"
	}
}
